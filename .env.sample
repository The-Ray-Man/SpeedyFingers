# Optional. Copy this file to `.env` next to docker-compose.yml; Docker Compose
# reads it automatically. See "The .env file" in README.md.

# User ids allowed to add, delete and re-threshold gestures.
# - Comma-separated, e.g. TRUSTED_USER_IDS=alice@example.com,bob@example.com
# - Each id must match the X-User-Id header exactly (case-sensitive).
#   Find a user's id in the `id` field of /api/me.
# - Empty means no one can edit gestures.
# - Recreate the backend after changing it: docker compose up -d --no-build
TRUSTED_USER_IDS=
